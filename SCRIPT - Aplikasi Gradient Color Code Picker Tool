<!-- Wrapper untuk memastikan posisi box selalu di tengah -->
<div style="display: flex; justify-content: center; align-items: flex-start; min-height: 100vh; padding: 20px; background-color: #0a0a0a;">

    <div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; width: 100%; max-width: 450px; padding: 25px; border-radius: 20px; background-color: #121212; color: #ffffff; box-shadow: 0 20px 50px rgba(0,0,0,0.8); border: 1px solid #333; position: relative;">
        
        <h2 style="margin-top: 0; text-align: center; color: #ff3333; letter-spacing: 1px; margin-bottom: 25px; font-size: 24px;">Color Converter</h2>

        <!-- Box Preview & Picker Trigger -->
        <div id="colorPreview" style="position: relative; width: 100%; height: 120px; border-radius: 12px; background-color: #ff3333; margin-bottom: 20px; border: 2px solid #333; display: flex; align-items: center; justify-content: center; font-weight: bold; cursor: pointer; transition: 0.3s; overflow: hidden;">
            <span id="previewText" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.5); pointer-events: none; z-index: 2;">CLICK TO PICK COLOR</span>
            
            <!-- Hidden Picker yang menutupi seluruh box preview agar dialog muncul di sini -->
            <input type="color" id="nativePicker" oninput="syncFromPicker(this.value)" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: none;">
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; color: #aaa; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Enter HEX Color:</label>
            <input type="text" id="hexInput" value="#FF3333" oninput="convertColor()" style="width: 100%; padding: 15px; border: 2px solid #333; border-radius: 10px; background-color: #1a1a1a; color: #fff; font-size: 20px; box-sizing: border-box; outline: none; text-align: center; font-family: 'Courier New', Courier, monospace; transition: 0.2s;">
        </div>

        <div style="display: grid; gap: 12px;">
            <div class="result-row">
                <span class="label">RGB</span>
                <span id="rgbValue" class="value">rgb(255, 51, 51)</span>
            </div>
            <div class="result-row">
                <span class="label">HSL</span>
                <span id="hslValue" class="value">hsl(0, 100%, 60%)</span>
            </div>
            <div class="result-row">
                <span class="label">CMYK</span>
                <span id="cmykValue" class="value">0%, 80%, 80%, 0%</span>
            </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 25px;">
            <button onclick="copyToClipboard()" id="copyBtn" style="flex: 1; padding: 14px; background-color: #d32f2f; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; text-transform: uppercase;">
                Copy HEX
            </button>
            <button onclick="randomColor()" style="flex: 1; padding: 14px; background-color: #333; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; text-transform: uppercase;">
                Random
            </button>
        </div>
    </div>
</div>

<style>
    .result-row {
        background: #1a1a1a; 
        padding: 12px 15px; 
        border-radius: 10px; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border: 1px solid #2a2a2a;
    }
    .label { color: #666; font-size: 12px; font-weight: bold; }
    .value { font-family: 'Courier New', monospace; color: #00ff88; font-size: 14px; }
    
    button:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
    button:active { transform: translateY(0); }
    
    #hexInput:focus { border-color: #ff3333; box-shadow: 0 0 10px rgba(255, 51, 51, 0.2); }
    
    #colorPreview:hover { border-color: #666; transform: scale(1.02); }
</style>

<script>
    function syncFromPicker(val) {
        document.getElementById('hexInput').value = val.toUpperCase();
        convertColor();
    }

    function convertColor() {
        let hex = document.getElementById('hexInput').value;
        if (!hex.startsWith('#')) hex = '#' + hex;
        
        // Regex check for valid hex
        if (/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)) {
            const preview = document.getElementById('colorPreview');
            const nativePicker = document.getElementById('nativePicker');
            
            // Update UI
            preview.style.backgroundColor = hex;
            nativePicker.value = hex.length === 4 ? 
                '#' + hex[1] + hex[1] + hex[2] + hex[2] + hex[3] + hex[3] : hex;
            
            // HEX to RGB
            let r, g, b;
            if (hex.length === 4) {
                r = parseInt(hex[1] + hex[1], 16);
                g = parseInt(hex[2] + hex[2], 16);
                b = parseInt(hex[3] + hex[3], 16);
            } else {
                r = parseInt(hex.slice(1, 3), 16);
                g = parseInt(hex.slice(3, 5), 16);
                b = parseInt(hex.slice(5, 7), 16);
            }
            
            document.getElementById('rgbValue').innerText = `rgb(${r}, ${g}, ${b})`;

            // RGB to HSL
            let rNorm = r / 255, gNorm = g / 255, bNorm = b / 255;
            let max = Math.max(rNorm, gNorm, bNorm), min = Math.min(rNorm, gNorm, bNorm);
            let h, s, l = (max + min) / 2;
            if (max == min) { h = s = 0; } else {
                let d = max - min;
                s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
                switch (max) {
                    case rNorm: h = (gNorm - bNorm) / d + (gNorm < bNorm ? 6 : 0); break;
                    case gNorm: h = (bNorm - rNorm) / d + 2; break;
                    case bNorm: h = (rNorm - gNorm) / d + 4; break;
                }
                h /= 6;
            }
            document.getElementById('hslValue').innerText = `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;

            // RGB to CMYK
            let k = 1 - Math.max(rNorm, gNorm, bNorm);
            let c = k === 1 ? 0 : (1 - rNorm - k) / (1 - k);
            let m = k === 1 ? 0 : (1 - gNorm - k) / (1 - k);
            let y = k === 1 ? 0 : (1 - bNorm - k) / (1 - k);
            
            document.getElementById('cmykValue').innerText = 
                `${Math.round(c*100)}%, ${Math.round(m*100)}%, ${Math.round(y*100)}%, ${Math.round(k*100)}%`;
            
            // Contrast check for preview text
            const brightness = (r * 299 + g * 587 + b * 114) / 1000;
            document.getElementById('previewText').style.color = brightness > 125 ? '#000' : '#fff';
        }
    }

    function randomColor() {
        const letters = '0123456789ABCDEF';
        let color = '#';
        for (let i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        document.getElementById('hexInput').value = color;
        convertColor();
    }

    function copyToClipboard() {
        const hex = document.getElementById('hexInput');
        const btn = document.getElementById('copyBtn');
        
        navigator.clipboard.writeText(hex.value).then(() => {
            const originalText = btn.innerText;
            btn.innerText = 'COPIED!';
            btn.style.backgroundColor = '#2e7d32';
            setTimeout(() => {
                btn.innerText = originalText;
                btn.style.backgroundColor = '#d32f2f';
            }, 1500);
        });
    }

    // Initialize
    convertColor();
</script>
