
<div id="password-generator-tool">
  <div class="pg-header">
    <h2>Password Generator</h2>
  </div>
  
  <div class="pg-body">
    <div class="output-container">
      <input type="text" id="password-display" placeholder="----" readonly>
      <button onclick="copyPassword()" class="btn-copy">Copy</button>
    </div>

    <p class="instruction">Pilih opsi di bawah dan klik "Generate". Password Anda akan muncul di kotak atas.</p>

    <div class="settings-group">
      <div class="length-setting">
        <label>Panjang Password: <span id="length-val">12</span></label>
        <input type="range" id="password-length" min="4" max="32" value="12" oninput="updateLength(this.value)">
      </div>

      <div class="options-list">
        <label class="option-item">
          <input type="checkbox" id="include-lowercase" checked>
          <span>Gunakan huruf kecil (abc)</span>
        </label>
        <label class="option-item">
          <input type="checkbox" id="include-uppercase" checked>
          <span>Gunakan huruf besar (ABC)</span>
        </label>
        <label class="option-item">
          <input type="checkbox" id="include-numbers" checked>
          <span>Gunakan angka (123)</span>
        </label>
        <label class="option-item">
          <input type="checkbox" id="include-symbols">
          <span>Gunakan karakter unik (!@#)</span>
        </label>
      </div>
    </div>

    <button onclick="generatePassword()" class="btn-generate">GENERATE!</button>
  </div>
</div>

<style>
  #password-generator-tool {
    max-width: 450px;
    margin: 20px auto;
    /* Latar Belakang Hitam */
    background: #000000;
    border: 2px solid #333;
    border-radius: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(255,0,0,0.1);
    color: #ffffff;
  }
  
  .pg-header { 
    /* Header Merah Gelap */
    background: #d90429; 
    padding: 20px; 
    color: #fff; 
  }
  .pg-header h2 { margin: 0; font-size: 22px; text-align: center; letter-spacing: 1px; text-transform: uppercase; }
  
  .pg-body { padding: 25px; }
  
  .output-container { display: flex; gap: 8px; margin-bottom: 15px; }
  
  #password-display {
    flex: 1;
    padding: 12px;
    /* Kontras teks password */
    background: #111;
    border: 1px solid #444;
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 20px;
    color: #00ff41; /* Hijau matrix untuk password agar mudah dibaca */
    outline: none;
  }
  
  .btn-copy { 
    background: #333; 
    color: #fff; 
    border: 1px solid #444; 
    padding: 0 20px; 
    border-radius: 6px; 
    cursor: pointer; 
    font-weight: bold;
    transition: 0.3s;
  }
  .btn-copy:hover { background: #ff0000; border-color: #ff0000; }
  
  .instruction { font-size: 13px; color: #888; line-height: 1.5; margin-bottom: 25px; }
  
  .settings-group { margin-bottom: 25px; }
  
  .length-setting { margin-bottom: 20px; }
  .length-setting label { display: block; margin-bottom: 12px; font-weight: bold; color: #ccc; }
  
  /* Styling Range Slider */
  #password-length { 
    width: 100%; 
    cursor: pointer; 
    accent-color: #ff0000; 
  }
  
  .options-list { border-top: 1px solid #222; }
  
  .option-item {
    display: flex;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #222;
    cursor: pointer;
    font-size: 14px;
    color: #bbb;
    transition: 0.2s;
  }
  .option-item:hover { color: #fff; }
  .option-item input { margin-right: 15px; width: 18px; height: 18px; accent-color: #ff0000; }
  
  /* Tombol Generate Merah */
  .btn-generate {
    width: 100%;
    padding: 15px;
    background: #ef233c;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    letter-spacing: 1px;
  }
  .btn-generate:hover { background: #ff0000; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255, 0, 0, 0.3); }
  .btn-generate:active { transform: translateY(0); }
</style>

<script>
  function updateLength(val) {
    document.getElementById('length-val').innerText = val;
  }

  function generatePassword() {
    const length = document.getElementById('password-length').value;
    const lower = "abcdefghijklmnopqrstuvwxyz";
    const upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const numbers = "0123456789";
    const symbols = "!@#$%^&*()_+~`|}{[]:;?><,./-=";

    let charSet = "";
    if(document.getElementById('include-lowercase').checked) charSet += lower;
    if(document.getElementById('include-uppercase').checked) charSet += upper;
    if(document.getElementById('include-numbers').checked) charSet += numbers;
    if(document.getElementById('include-symbols').checked) charSet += symbols;

    if(charSet === "") {
      alert("Pilih setidaknya satu opsi!");
      return;
    }

    let password = "";
    for (let i = 0; i < length; i++) {
      password += charSet.charAt(Math.floor(Math.random() * charSet.length));
    }
    document.getElementById('password-display').value = password;
  }

  function copyPassword() {
    const copyText = document.getElementById("password-display");
    if(!copyText.value || copyText.value === "----") return;
    copyText.select();
    document.execCommand("copy");
    alert("Password berhasil disalin ke clipboard!");
  }
</script>


