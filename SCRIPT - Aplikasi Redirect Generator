

<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 500px; margin: 20px auto; padding: 25px; border: 1px solid #333; border-radius: 12px; background-color: #121212; box-shadow: 0 8px 30px rgba(0,0,0,0.5); color: #e0e0e0;">
    
    <h2 style="margin-top: 0; color: #ff5252; font-size: 20px; text-align: center; margin-bottom: 25px; letter-spacing: 0.5px;">Redirect Generator</h2>

    <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #bbb; font-size: 13px;">Select redirect type:</label>
    <select id="redirectType" style="width: 100%; padding: 12px; border: 1px solid #444; border-radius: 6px; background-color: #1e1e1e; color: #fff; margin-bottom: 20px; font-size: 14px; outline: none;">
        <option value="meta">HTML meta tag redirect</option>
        <option value="js">JavaScript redirect</option>
        <option value="php">PHP redirect</option>
    </select>

    <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #bbb; font-size: 13px;">Enter Destination URL:</label>
    <input type="text" id="destUrl" placeholder="https://www.new-page.com" style="width: 100%; padding: 12px; border: 1px solid #444; border-radius: 6px; box-sizing: border-box; background-color: #1e1e1e; color: #fff; margin-bottom: 20px; font-size: 14px; outline: none;">

    <button onclick="generateRedirect()" style="width: 100%; padding: 14px; background-color: #d32f2f; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 16px; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(211, 47, 47, 0.2);">
        GENERATE
    </button>

    <div id="resultContainer" style="display: none; margin-top: 25px;">
        <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #bbb; font-size: 13px;">Generated Code:</label>
        <textarea id="resultCode" readonly style="width: 100%; height: 100px; padding: 12px; border: 1px solid #333; border-radius: 6px; background-color: #000; color: #4ec9b0; font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; resize: none; box-sizing: border-box; outline: none;"></textarea>
        
        <button id="copyBtn" onclick="copyToClipboard()" style="margin-top: 12px; padding: 10px 18px; background-color: #333; color: white; border: 1px solid #444; border-radius: 4px; cursor: pointer; font-size: 13px; display: flex; align-items: center; gap: 8px; transition: 0.2s;">
            <span>📋</span> Copy Code
        </button>
    </div>
</div>

<script>
    function generateRedirect() {
        const type = document.getElementById('redirectType').value;
        const url = document.getElementById('destUrl').value || 'https://example.com';
        const resultContainer = document.getElementById('resultContainer');
        const resultCode = document.getElementById('resultCode');
        let code = '';

        if (type === 'meta') {
            code = `<meta http-equiv="refresh" content="0; url=${url}">`;
        } else if (type === 'js') {
            code = `<script type="text/javascript">\n  window.location.href = "${url}";\n<\/script>`;
        } else if (type === 'php') {
            code = `<?php\nheader("Location: ${url}");\nexit();\n?>`;
        }

        resultCode.value = code;
        resultContainer.style.display = 'block';
    }

    function copyToClipboard() {
        const codeText = document.getElementById('resultCode');
        codeText.select();
        codeText.setSelectionRange(0, 99999);
        
        try {
            document.execCommand('copy');
            const btn = document.getElementById('copyBtn');
            btn.style.backgroundColor = '#d32f2f';
            btn.style.borderColor = '#ff5252';
            btn.innerHTML = '<span>✅</span> Copied!';
            
            setTimeout(() => {
                btn.style.backgroundColor = '#333';
                btn.style.borderColor = '#444';
                btn.innerHTML = '<span>📋</span> Copy Code';
            }, 2000);
        } catch (err) {
            alert('Gagal menyalin teks.');
        }
    }
</script>

<style>
    /* Interaksi tombol */
    button:hover {
        opacity: 0.95;
        filter: brightness(1.1);
    }
    button:active {
        transform: translateY(1px);
    }
    input:focus, select:focus {
        border-color: #d32f2f !important;
    }
</style>
