

<div class="wc-container" style="max-width: 100%; font-family: 'Segoe UI', Roboto, Arial, sans-serif; padding: 30px; border: 1px solid #333; border-radius: 15px; background-color: #000000; box-shadow: 0 10px 30px rgba(255,0,0,0.15); color: #ffffff;">
  
  <h3 style="margin-top: 0; color: #ff0000; text-align: center; margin-bottom: 25px; text-transform: uppercase; letter-spacing: 2px;">Text Analyzer Tool</h3>
  
  <textarea id="textInput" placeholder="Tempelkan teks Anda di sini..." style="width: 100%; height: 180px; padding: 15px; border: 2px solid #222; border-radius: 10px; font-size: 16px; box-sizing: border-box; outline: none; background: #0a0a0a; color: #fff; transition: border-color 0.3s; resize: vertical;"></textarea>

  <div style="display: flex; gap: 12px; margin: 25px 0;">
    <button onclick="hitungProses()" style="flex: 2; padding: 14px; background: #ff0000; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; transition: all 0.3s; text-transform: uppercase;" onmouseover="this.style.backgroundColor='#cc0000'; this.style.boxShadow='0 0 15px rgba(255,0,0,0.4)'" onmouseout="this.style.backgroundColor='#ff0000'; this.style.boxShadow='none'">
      🚀 Hitung Sekarang
    </button>
    <button onclick="clearText()" style="flex: 1; padding: 14px; background: transparent; color: #666; border: 1px solid #333; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; transition: all 0.3s;" onmouseover="this.style.color='#fff'; this.style.borderColor='#ff0000'" onmouseout="this.style.color='#666'; this.style.borderColor='#333'">
      Reset
    </button>
  </div>

  <div class="wc-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px;">
    <div style="padding: 20px; background: #050505; border: 1px solid #222; border-radius: 12px; text-align: center; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#ff0000'" onmouseout="this.style.borderColor='#222'">
      <div style="font-size: 11px; color: #ff4d4d; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px;">Karakter</div>
      <div id="charCount" style="font-size: 28px; font-weight: bold; color: #ffffff; text-shadow: 0 0 10px rgba(255,255,255,0.1);">0</div>
    </div>
    
    <div style="padding: 20px; background: #050505; border: 1px solid #222; border-radius: 12px; text-align: center; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#ff0000'" onmouseout="this.style.borderColor='#222'">
      <div style="font-size: 11px; color: #ff4d4d; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px;">Tanpa Spasi</div>
      <div id="noSpaceCount" style="font-size: 28px; font-weight: bold; color: #ffffff;">0</div>
    </div>

    <div style="padding: 20px; background: #050505; border: 1px solid #222; border-radius: 12px; text-align: center; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#ff0000'" onmouseout="this.style.borderColor='#222'">
      <div style="font-size: 11px; color: #ff4d4d; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px;">Kata</div>
      <div id="wordCount" style="font-size: 28px; font-weight: bold; color: #ffffff;">0</div>
    </div>

    <div style="padding: 20px; background: #050505; border: 1px solid #222; border-radius: 12px; text-align: center; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#ff0000'" onmouseout="this.style.borderColor='#222'">
      <div style="font-size: 11px; color: #ff4d4d; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px;">Paragraf</div>
      <div id="paraCount" style="font-size: 28px; font-weight: bold; color: #ffffff;">0</div>
    </div>
  </div>
</div>

<script>
  // Menambahkan efek fokus dinamis pada textarea lewat JS
  const tx = document.getElementById('textInput');
  tx.onfocus = function() { this.style.borderColor = '#ff0000'; };
  tx.onblur = function() { this.style.borderColor = '#222'; };

  function hitungProses() {
    const text = document.getElementById('textInput').value;
    
    document.getElementById('charCount').innerText = text.length;
    document.getElementById('noSpaceCount').innerText = text.replace(/\s/g, '').length;

    const words = text.trim().split(/\s+/);
    document.getElementById('wordCount').innerText = text.trim() === '' ? 0 : words.length;

    const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);
    document.getElementById('paraCount').innerText = paragraphs.length;
  }

  function clearText() {
    document.getElementById('textInput').value = '';
    document.getElementById('charCount').innerText = '0';
    document.getElementById('noSpaceCount').innerText = '0';
    document.getElementById('wordCount').innerText = '0';
    document.getElementById('paraCount').innerText = '0';
  }
</script>

